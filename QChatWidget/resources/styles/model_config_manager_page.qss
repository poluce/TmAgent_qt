/* ============================================================================
 * ModelConfigManagerPage 页面特有样式
 * ============================================================================
 * 说明: 本文件只包含 ModelConfigManagerPage 页面特有的样式
 *       通用样式已在 global.qss 中定义
 * ============================================================================
 */

/* 页面根容器 */
QWidget {
    background-color: #f9fafb;
}

/* 面板标题 */
#panelTitle {
    font-size: 14px;
    font-weight: bold;
    color: #1f2937;
    padding: 4px 0;
}

/* 分割线 */
#separator {
    background-color: #e5e7eb;
}

/* ---- 左侧：已导入配置列表 ---- */

QListWidget#configList {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    outline: none;
}

QListWidget#configList::item {
    padding: 4px 8px;
    border-radius: 10px;
    margin: 2px 4px;
}

QListWidget#configList::item:selected {
    background: #eef2ff;
}

QListWidget#configList::item:hover:!selected {
    background: #f3f4f6;
}

/* 列表项内部 */
#configItemWidget {
    background: transparent;
}

#configName {
    font-size: 13px;
    font-weight: 500;
    color: #1f2937;
    background: transparent;
}

#providerTag {
    font-size: 11px;
    color: #6b7280;
    background: transparent;
}

#defaultMark {
    font-size: 11px;
    color: #f59e0b;
    font-weight: bold;
    background: transparent;
}

#enabledCheck {
    background: transparent;
}

/* 左侧底部按钮 */
#newConfigBtn {
    background: #4b7bec;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 5px 12px;
    font-weight: 500;
}

#newConfigBtn:hover {
    background: #3b6fe0;
}

#setDefaultBtn {
    background: #f4f6f9;
    border: 1px solid #e1e4ea;
    border-radius: 10px;
    padding: 5px 12px;
    font-weight: 500;
    color: #374151;
}

#setDefaultBtn:hover {
    background: #eef2f7;
}

#setDefaultBtn:disabled {
    color: #9ca3af;
}

#deleteBtn {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 10px;
    padding: 5px 12px;
    font-weight: 500;
    color: #dc2626;
}

#deleteBtn:hover {
    background: #fee2e2;
}

#deleteBtn:disabled {
    color: #9ca3af;
    background: #f4f6f9;
    border-color: #e1e4ea;
}

/* ---- 右侧：厂商按钮 pill 样式 ---- */

#providerBar {
    background: transparent;
}

#providerPill {
    border: 1px solid #d1d5db;
    border-radius: 16px;
    padding: 5px 16px;
    background: #ffffff;
    color: #4b5563;
    font-weight: 500;
    min-width: 60px;
}

#providerPill:hover {
    background: #f3f4f6;
    border-color: #9ca3af;
}

#providerPill:checked {
    background: #eef2ff;
    border-color: #6366f1;
    color: #4f46e5;
    font-weight: bold;
}

/* ---- 右侧：表单区域 ---- */

#detailStack {
    background: #ffffff;
    border-radius: 14px;
}

/* 配置名称输入框 */
#configIdEdit {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px;
    background: #ffffff;
}

#configIdEdit:focus {
    border: 2px solid #6366f1;
}

#configIdEdit[readOnly="true"] {
    background: #f3f4f6;
    color: #6b7280;
}

/* 通用输入框 */
QLineEdit {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 8px;
    background: #ffffff;
}

QLineEdit:focus {
    border: 2px solid #6366f1;
    border-radius: 10px;
}

/* 下拉框 */
QComboBox {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 6px 8px;
    background: #ffffff;
}

QComboBox:focus {
    border: 2px solid #6366f1;
}

/* ---- 右侧底部按钮 ---- */

#saveBtn {
    background: #4b7bec;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 6px 14px;
    font-weight: 500;
    min-width: 80px;
}

#saveBtn:hover {
    background: #3b6fe0;
}

#saveBtn:pressed {
    background: #2f62d6;
}

#testBtn {
    background: #f4f6f9;
    border: 1px solid #e1e4ea;
    border-radius: 12px;
    padding: 6px 14px;
    font-weight: 500;
    color: #374151;
    min-width: 80px;
}

#testBtn:hover {
    background: #eef2f7;
}

#testBtn:pressed {
    background: #e2e8f0;
}

/* 字段错误提示 */
#fieldError {
    color: #ef4444;
    font-size: 12px;
    background: transparent;
}

/* 测试状态提示 */
#testStatusLabel[status="idle"] {
    color: #6b7280;
}

#testStatusLabel[status="testing"] {
    color: #2563eb;
}

#testStatusLabel[status="success"] {
    color: #16a34a;
}

#testStatusLabel[status="failed"] {
    color: #dc2626;
}
