/* 设置页面通用样式 */
.SettingsHeader {
    background-color: transparent;
    border-bottom: 1px solid #d1d5db;
}

.SettingsTitle {
    font-size: 16px;
    font-weight: bold;
}

.SettingsSubTitle {
    font-size: 11px;
    color: #6b7280;
}

.SettingsFooter {
    border-top: 1px solid #d1d5db;
}

.SettingsTabWidget::pane {
    border: none;
}

.SettingsTabBar::tab {
    padding: 10px 20px;
    font-weight: normal;
}

.SettingsTabBar::tab:selected {
    font-weight: bold;
    border-bottom: 2px solid palette(highlight);
}

.SettingsGroup {
    font-weight: bold;
}

.PathLabel {
    color: #6b7280;
}

.MonospaceLabel {
    font-family: monospace;
    color: #4b5563;
}
